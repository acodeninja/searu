#!/bin/sh
set -eu

if grep -Eqi 'claude-session:|co-authored-by:.*claude|generated with .*claude|claude\.ai/code' "$1"; then
    echo "commit-msg: remove AI attribution trailers; they are not allowed in this repo."
    exit 1
fi

subject=$(head -n 1 "$1")

case "$subject" in
    "Merge "* | "Revert "* | "fixup! "* | "squash! "*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .+'
if printf '%s' "$subject" | grep -Eq "$pattern"; then
    if [ "${#subject}" -le 72 ]; then
        exit 0
    fi
    echo "commit-msg: subject is ${#subject} chars; keep it to 72 or fewer."
    exit 1
fi

echo "commit-msg: subject must follow Conventional Commits:"
echo "  <type>[(scope)][!]: <description>"
echo "  types: feat fix docs style refactor perf test build ci chore revert"
echo "got: $subject"
exit 1
